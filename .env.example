# Neon PostgreSQL; use the least-privilege catering_watch_app role.
DATABASE_URL=postgresql://catering_watch_app:<PASSWORD>@<NEON_HOST>/catering_monitor?channel_binding=require&sslmode=require

# Required for direct Apify REST API runs.
APIFY_TOKEN=apify_api_<YOUR_TOKEN>

PROJECT_KEY=guangzhou_catering_competitors
MAX_COST_USD=1.00
CACHE_TTL_HOURS=24
MAX_ITEMS_PER_SEARCH=5
HTTP_TIMEOUT_SECONDS=90
# Optional shared UTC-day ceiling (defaults to MAX_COST_USD) and Actor build selector
DAILY_BUDGET_USD=1.00
APIFY_BUILD=latest
# Codex Cloud can inject these variables directly at agent runtime.
# APIFY_API_KEY is also accepted when APIFY_TOKEN is unset.
